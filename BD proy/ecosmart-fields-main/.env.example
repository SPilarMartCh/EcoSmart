# Copia este archivo a ".env" (NUNCA subas el .env real a GitHub).

# --- Supabase ---
# Project URL y clave pública ("anon"/"publishable") de tu proyecto Supabase.
# La anon key es segura de exponer en el frontend: Supabase la protege con
# Row Level Security (RLS) en cada tabla, no ocultándola.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon

# --- Dispositivo ---
# Debe coincidir con DEVICE_ID en raspberry/.env para que la app web y el
# agente de la Raspberry Pi lean/escriban las mismas filas.
VITE_DEVICE_ID=ecosmart-pi-01
