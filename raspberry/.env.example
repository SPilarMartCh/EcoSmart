# Copia este archivo a ".env" y ajusta los valores.
# NUNCA subas el archivo ".env" real a GitHub (ver .gitignore).

# --- Modo de operación ---
# "simulator" = sin hardware físico (para desarrollo/pruebas)
# "real"      = con sensores/relé conectados a la Raspberry Pi
HARDWARE_MODE=simulator

# --- Identificación del dispositivo ---
DEVICE_ID=ecosmart-pi-01

# --- Base de datos local ---
DB_PATH=./database/ecosmart.db

# --- I2C / ADS1115 ---
ADS1115_I2C_ADDRESS=0x48
ADS1115_CHANNEL=0

# --- GPIO / Relé ---
RELAY_GPIO_PIN=17
RELAY_ACTIVE_LOW=true

# --- Ciclo de lectura de sensores (segundos) ---
SENSOR_READ_INTERVAL_SECONDS=10

# --- Seguridad ---
MANUAL_IRRIGATION_MAX_SECONDS=300
MAX_CONSECUTIVE_INVALID_READINGS=5
READING_STALE_AFTER_SECONDS=120
MAX_IRRIGATION_CYCLES_PER_WINDOW=6
IRRIGATION_CYCLE_WINDOW_SECONDS=3600

# --- Calibración por defecto (se puede recalibrar luego desde la app) ---
DEFAULT_CALIBRATION_DRY_ADC=27000
DEFAULT_CALIBRATION_WET_ADC=12000

# --- Backend (se usará en Fase 2) ---
BACKEND_BASE_URL=http://localhost:4000
DEVICE_API_KEY=cambia_esta_clave_en_produccion

# --- Supabase (sincronización real) ---
# Debe ser EXACTAMENTE el mismo proyecto que usa el frontend
# (BD proy/ecosmart-fields-main/.env -> VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-publica-anon
SUPABASE_SYNC_ENABLED=true
